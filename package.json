{
  "name": "local-rag-assistant",
  "version": "0.1.0",
  "description": "Local Retrieval-Augmented Generation assistant: ingest PDF/Markdown/TXT, embed with Ollama, answer with streamed, cited responses.",
  "scripts": {
    "build:web": "esbuild web/app.ts --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "dev": "npm run build:web && tsx src/main.ts",
    "start": "node dist/main.js",
    "ingest": "tsx src/cli/ingest.ts",
    "ask": "tsx src/cli/ask.ts",
    "eval": "tsx eval/run-eval.ts",
    "eval:faithfulness": "tsx eval/run-faithfulness.ts",
    "make:pdf": "tsx scripts/make-sample-pdf.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rag",
    "ollama",
    "typescript",
    "sqlite",
    "embeddings"
  ],
  "author": "Sahil Ambekar",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}

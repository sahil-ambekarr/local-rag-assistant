# Copy to .env and adjust. Every value below is the default.

# ollama (default) | claude | mock
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# Claude (chat only; embeddings still come from Ollama). Leave the key empty unless you use LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Embeddings: ollama | mock. Defaults to mock when LLM_PROVIDER=mock, otherwise ollama.
# EMBED_PROVIDER=ollama

# Server and storage
PORT=4101
DB_PATH=./data/rag.db

# Chunking and retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_SCORE=0

# Outbound call limits
CHAT_TIMEOUT_MS=300000
EMBED_TIMEOUT_MS=120000
MAX_RETRIES=2
MAX_UPLOAD_MB=20

# debug | info | warn | error | silent
LOG_LEVEL=info
